{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glyphbook catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "icons"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "icons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/icon"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "polarityColor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dark", "light"],
      "properties": {
        "dark": { "$ref": "#/$defs/color" },
        "light": { "$ref": "#/$defs/color" }
      }
    },
    "domain": {
      "type": "string",
      "pattern": "^(\\*|(?:\\*\\.)?(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)$"
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glyph", "color"],
      "properties": {
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2
        },
        "color": { "$ref": "#/$defs/polarityColor" },
        "colorRole": {
          "type": "string",
          "minLength": 1
        },
        "applications": {
          "$ref": "#/$defs/strings"
        },
        "symbols": {
          "$ref": "#/$defs/strings"
        },
        "nerdFontNames": {
          "$ref": "#/$defs/strings"
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/domain"
          }
        },
        "defaults": {
          "$ref": "#/$defs/strings"
        },
        "directories": {
          "$ref": "#/$defs/strings"
        },
        "extensions": {
          "$ref": "#/$defs/strings"
        },
        "files": {
          "$ref": "#/$defs/strings"
        },
        "editorFiletypes": {
          "$ref": "#/$defs/strings"
        },
        "lsp": {
          "$ref": "#/$defs/strings"
        },
        "operatingSystems": {
          "$ref": "#/$defs/strings"
        }
      },
      "anyOf": [
        {
          "required": ["nerdFontNames"]
        },
        {
          "required": ["applications"]
        },
        {
          "required": ["domains"]
        },
        {
          "required": ["defaults"]
        },
        {
          "required": ["directories"]
        },
        {
          "required": ["extensions"]
        },
        {
          "required": ["files"]
        },
        {
          "required": ["editorFiletypes"]
        },
        {
          "required": ["lsp"]
        },
        {
          "required": ["operatingSystems"]
        }
      ]
    }
  }
}
